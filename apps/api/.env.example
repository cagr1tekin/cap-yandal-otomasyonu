# apps/api/.env olarak kopyalayın
DATABASE_URL=postgresql://cap:cap_dev@localhost:5442/cap_takip?schema=public
REDIS_URL=redis://localhost:6389
PORT=4000
WEB_ORIGIN=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1035
MAIL_FROM="ÇAP-Yan Dal Sistemi <noreply@cap.test>"
WORKER_ENABLED=true
LOG_PRETTY=true
UPLOAD_DIR=./storage
# Oturum belirteçlerinin imza anahtarı: en az 32 karakter rastgele değer girin
AUTH_SECRET=yerel-gelistirme-icin-en-az-32-karakterlik-rastgele-dizge
# Barındırmada (kalıcı disk yoksa) belgeler veritabanında tutulur
STORAGE_DRIVER=disk
