// Bilgisayar Mühendisliği ÇAP / Yan Dal Otomasyonu — veri modeli (docs/KARARLAR.md K-12).
// OBİS bağlantısı yoktur: öğrenci akademik bilgilerini kendisi girer, koordinatör belgeyle doğrular.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Season {
  GUZ
  BAHAR
}

enum TrackType {
  CAP
  YANDAL
}

enum CourseKind {
  ZORUNLU
  TEKNIK_SECMELI
  SOSYAL_SECMELI
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RuleSetStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ApplicationPath {
  RANK
  ENTRY_SCORE
}

enum ApplicationStatus {
  SUBMITTED
  INELIGIBLE
  WITHDRAWN
  UNDER_REVIEW
  PROPOSED
  ACCEPTED
  WAITLISTED
  REJECTED
  ENROLLED
  NOT_ENROLLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  MISMATCH
}

enum Proposal {
  ASIL
  YEDEK
  RET
}

enum EnrollmentStatus {
  ACTIVE
  FROZEN
  WITHDRAWN
  REMOVED
  COMPLETED
}

enum DocumentKind {
  TRANSKRIPT
  BASARI_BELGESI
  YKS_BELGESI
  DONEM_TRANSKRIPTI
  DIGER
}

enum ProtocolItemKind {
  COURSE
  ELECTIVE_SLOT
}

enum ProtocolItemStatus {
  PENDING
  PASSED
  FAILED
  EXEMPT
}

enum FormStatus {
  DRAFT
  IN_APPROVAL
  APPROVED
  REJECTED
}

enum ApprovalSubject {
  PROTOCOL
  COURSE_REG
  EXEMPTION
}

enum ApprovalRole {
  OGRENCI
  ANA_DAL_DANISMANI
  ANA_DAL_BOLUM_BASKANI
  KOORDINATOR
  CAP_BOLUM_BASKANI
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveReason {
  ERASMUS
  FARABI
  DERS_ACILMADI
  DERS_CAKISMASI
  DIGER
}

enum ScanStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum FindingDecision {
  PENDING
  CONFIRMED
  DISMISSED
}

/// Personel rolleri. Öğrenciye rol atanmaz; personel rolü olmayan hesap öğrencidir.
enum StaffRole {
  DANISMAN
  KOORDINATOR
  BOLUM_BASKANI
}

// ---------------------------------------------------------------- Tanımlar

/// Bölümler: Bilgisayar Mühendisliği (isHome) ve öğrencilerin geldiği ana dal bölümleri.
model Program {
  id         String                  @id
  name       String
  faculty    String
  codePrefix String?
  isHome     Boolean                 @default(false)
  sourceFor  OfferingSourceProgram[]
  students   StudentProfile[]
  templates  ProtocolTemplate[]
  roles      RoleAssignment[]
}

/// Bilgisayar Mühendisliği müfredatı (Bologna ders paketi).
model Course {
  code     String     @id
  name     String
  ects     Int
  semester Int
  kind     CourseKind
}

model Term {
  id          String               @id
  year        String
  season      Season
  startsAt    DateTime
  endsAt      DateTime
  isCurrent   Boolean              @default(false)
  offerings   Offering[]
  scans       TermScan[]
  enrollments Enrollment[]
  courseRegs  CourseRegistration[]
  records     TermRecord[]
  leaves      TermLeave[]

  @@unique([year, season])
}

/// Dönemlik ÇAP / yan dal teklifi: kontenjan, kaynak bölümler ve takvim.
model Offering {
  id                   String                  @id @default(cuid())
  termId               String
  term                 Term                    @relation(fields: [termId], references: [id])
  type                 TrackType
  quota                Int
  firstYearIntake      Int?
  quotaJustification   String?
  status               OfferingStatus          @default(DRAFT)
  opensAt              DateTime
  closesAt             DateTime
  announceAt           DateTime?
  registrationDeadline DateTime?
  waitlistDeadline     DateTime?
  rankingLockedAt      DateTime?
  registrationClosedAt DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  sourcePrograms       OfferingSourceProgram[]
  applications         Application[]
  decisions            BoardDecision[]
  enrollments          Enrollment[]

  @@unique([termId, type])
}

/// Teklifin başvuru kabul ettiği bölümler (boşsa her bölüm).
model OfferingSourceProgram {
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  programId  String
  program    Program  @relation(fields: [programId], references: [id])

  @@id([offeringId, programId])
}

/// Bilgisayar Mühendisliğinin yıllara göre taban puanı ve başarı sırası şartı (KR-ÇAP-03b, KR-ÇAP-04).
model YearStat {
  year             Int      @id
  baseScore        Float
  successRankLimit Int?
  updatedBy        String?
  updatedAt        DateTime @updatedAt
}

model RuleSet {
  id            String           @id @default(cuid())
  version       String           @unique
  type          TrackType
  effectiveFrom DateTime
  status        RuleSetStatus    @default(DRAFT)
  note          String?
  createdBy     String?
  createdAt     DateTime         @default(now())
  rules         RuleDefinition[]
  applications  Application[]
  scans         TermScan[]
}

model RuleDefinition {
  id        String  @id @default(cuid())
  ruleSetId String
  ruleSet   RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  code      String
  kind      String
  article   String
  title     String
  phase     String
  params    Json
  position  Int

  @@unique([ruleSetId, code])
}

// ---------------------------------------------------------------- Kullanıcılar

model User {
  id          String           @id @default(cuid())
  username    String           @unique
  oidcSub     String?          @unique
  displayName String
  email       String?
  lastLoginAt DateTime?
  assignments RoleAssignment[]
  profile     StudentProfile?
}

/// Rol + kapsam. BOLUM_BASKANI ve DANISMAN için programId zorunludur.
model RoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StaffRole
  programId String?
  program   Program?  @relation(fields: [programId], references: [id])

  @@index([userId])
}

/// Öğrencinin kendi girdiği kimlik ve akademik bilgiler.
model StudentProfile {
  studentNo           String        @id
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  phone               String?
  programId           String
  program             Program       @relation(fields: [programId], references: [id])
  entryYear           Int
  semesterNo          Int
  gano                Float
  completedAllCourses Boolean
  classRank           Int?
  classSize           Int?
  entryScore          Float?
  successRank         Int?
  advisorUsername     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  documents           Document[]
  applications        Application[]
  enrollments         Enrollment[]
}

/// Öğrencinin yüklediği belge. Dosya diskte, özeti ve üst verisi burada tutulur.
model Document {
  id           String                @id @default(cuid())
  studentNo    String
  student      StudentProfile        @relation(fields: [studentNo], references: [studentNo], onDelete: Cascade)
  kind         DocumentKind
  fileName     String
  mimeType     String
  size         Int
  sha256       String
  storageKey   String
  uploadedAt   DateTime              @default(now())
  applications ApplicationDocument[]

  @@index([studentNo, kind])
}

// ---------------------------------------------------------------- Başvuru ve değerlendirme

model Application {
  id               String                @id @default(cuid())
  studentNo        String
  student          StudentProfile        @relation(fields: [studentNo], references: [studentNo])
  offeringId       String
  offering         Offering              @relation(fields: [offeringId], references: [id])
  ruleSetId        String
  ruleSet          RuleSet               @relation(fields: [ruleSetId], references: [id])
  path             ApplicationPath
  /// Başvuru anındaki öğrenci beyanı ve kural bağlamı (yeniden üretilebilirlik için)
  snapshot         Json
  eligibility      Json
  status           ApplicationStatus     @default(SUBMITTED)
  verification     VerificationStatus    @default(PENDING)
  verifiedBy       String?
  verifiedAt       DateTime?
  verificationNote String?
  withdrawReason   String?
  submittedAt      DateTime              @default(now())
  withdrawnAt      DateTime?
  updatedAt        DateTime              @updatedAt
  documents        ApplicationDocument[]
  ranking          Ranking?
  enrollment       Enrollment?

  @@unique([studentNo, offeringId])
  @@index([offeringId, status])
}

model ApplicationDocument {
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId])
}

model Ranking {
  applicationId  String      @id
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  score          Float
  rank           Int
  proposal       Proposal
  overriddenBy   String?
  overrideReason String?
  updatedAt      DateTime    @updatedAt
}

/// Fakülte yönetim kurulu kararının kaydı (karar EBYS'de alınır; burada sayısı ve tarihi tutulur).
model BoardDecision {
  id           String    @id @default(cuid())
  offeringId   String
  offering     Offering  @relation(fields: [offeringId], references: [id])
  decisionDate DateTime
  decisionNo   String
  recordedBy   String
  recordedAt   DateTime  @default(now())
  publishedAt  DateTime?
}

// ---------------------------------------------------------------- Kayıt, protokol, formlar

model Enrollment {
  id                  String               @id @default(cuid())
  studentNo           String
  student             StudentProfile       @relation(fields: [studentNo], references: [studentNo])
  offeringId          String
  offering            Offering             @relation(fields: [offeringId], references: [id])
  applicationId       String?              @unique
  application         Application?         @relation(fields: [applicationId], references: [id])
  type                TrackType
  status              EnrollmentStatus     @default(ACTIVE)
  startTermId         String
  startTerm           Term                 @relation(fields: [startTermId], references: [id])
  ganoStrikes         Int                  @default(0)
  mainAdvisorUsername String?
  /// Ana daldan mezuniyetteki GNO (mezuniyet denetimi için koordinatör girer)
  mainGraduationGano  Float?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  protocol            Protocol?
  courseRegistrations CourseRegistration[]
  exemptions          ExemptionRequest[]
  termRecords         TermRecord[]
  leaves              TermLeave[]
  findings            ScanFinding[]
  withdrawals         WithdrawalRequest[]

  @@index([studentNo])
  @@index([offeringId, status])
}

/// Bölümler arası Kabul ve Ders Protokolü şablonu (ÇAP: ana dal bölümü başına; yan dal: ders havuzu).
model ProtocolTemplate {
  id              String                 @id @default(cuid())
  type            TrackType
  sourceProgramId String?
  sourceProgram   Program?               @relation(fields: [sourceProgramId], references: [id])
  title           String
  /// Ana dalda alınan ve iki program için ortak sayılan derslerin AKTS toplamı (ÇAP Yön. m.7/2)
  commonEcts      Int                    @default(0)
  source          String?
  updatedBy       String?
  updatedAt       DateTime               @updatedAt
  items           ProtocolTemplateItem[]
  conditions      ProtocolCondition[]
  protocols       Protocol[]

  @@unique([type, sourceProgramId])
}

model ProtocolTemplateItem {
  id         String           @id @default(cuid())
  templateId String
  template   ProtocolTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position   Int
  kind       ProtocolItemKind
  code       String?
  name       String
  ects       Int
  semester   Int

  @@index([templateId, position])
}

/// Protokolün altındaki numaralı özel şart: ana dalda alınan ders, protokoldeki dersten muaf sayar.
model ProtocolCondition {
  id               String             @id @default(cuid())
  templateId       String
  template         ProtocolTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  no               Int
  sourceCourseCode String
  sourceCourseName String
  targetCourseCode String
  note             String?
  exemptions       ExemptionRequest[]

  @@unique([templateId, no])
}

/// Öğrenciye özgü Kabul ve Ders Protokolü (şablondan üretilir, 5 imza).
model Protocol {
  id           String           @id @default(cuid())
  enrollmentId String           @unique
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  templateId   String
  template     ProtocolTemplate @relation(fields: [templateId], references: [id])
  status       FormStatus       @default(DRAFT)
  round        Int              @default(1)
  commonEcts   Int              @default(0)
  createdBy    String
  submittedAt  DateTime?
  approvedAt   DateTime?
  updatedAt    DateTime         @updatedAt
  courses      ProtocolCourse[]
}

/// Protokol satırı: ders ya da seçmeli ders yeri. Durum ve not, dönem sonunda koordinatörce girilir.
model ProtocolCourse {
  id            String                   @id @default(cuid())
  protocolId    String
  protocol      Protocol                 @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  position      Int
  kind          ProtocolItemKind
  code          String?
  name          String
  ects          Int
  semester      Int
  status        ProtocolItemStatus       @default(PENDING)
  grade         String?
  /// Seçmeli yer hangi dersle dolduruldu / hangi dersten muaf sayıldı
  fulfilledCode String?
  fulfilledName String?
  termId        String?
  registrations CourseRegistrationItem[]
  exemptions    ExemptionRequest[]

  @@index([protocolId, position])
}

/// Dönemlik ders kayıt formu (FORM01): öğrenci hazırlar; öğrenci, ana dal danışmanı, koordinatör imzalar.
model CourseRegistration {
  id           String                   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  termId       String
  term         Term                     @relation(fields: [termId], references: [id])
  status       FormStatus               @default(DRAFT)
  round        Int                      @default(1)
  createdBy    String
  submittedAt  DateTime?
  approvedAt   DateTime?
  updatedAt    DateTime                 @updatedAt
  items        CourseRegistrationItem[]

  @@unique([enrollmentId, termId])
}

model CourseRegistrationItem {
  id                   String             @id @default(cuid())
  courseRegistrationId String
  courseRegistration   CourseRegistration @relation(fields: [courseRegistrationId], references: [id], onDelete: Cascade)
  protocolCourseId     String
  protocolCourse       ProtocolCourse     @relation(fields: [protocolCourseId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  ects                 Int

  @@unique([courseRegistrationId, protocolCourseId])
}

/// Özel Şartlı Derslerin Muafiyeti Formu (Rehber): öğrenci, ana dal danışmanı, koordinatör.
model ExemptionRequest {
  id               String            @id @default(cuid())
  enrollmentId     String
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  conditionId      String
  condition        ProtocolCondition @relation(fields: [conditionId], references: [id])
  protocolCourseId String
  protocolCourse   ProtocolCourse    @relation(fields: [protocolCourseId], references: [id], onDelete: Cascade)
  sourceGrade      String
  sourceTerm       String
  status           FormStatus        @default(IN_APPROVAL)
  round            Int               @default(1)
  createdAt        DateTime          @default(now())
  approvedAt       DateTime?

  @@unique([enrollmentId, conditionId])
}

/// Protokol, ders kayıt formu ve muafiyet formu imzaları; her imzacı için bir satır.
model Approval {
  id               String           @id @default(cuid())
  subjectType      ApprovalSubject
  subjectId        String
  round            Int
  role             ApprovalRole
  /// Boşsa: KOORDINATOR imzasını komisyon üyelerinden biri atar; diğer rollerde hesabı olmayan
  /// imzacının ıslak imzasını koordinatör işler.
  assigneeUsername String?
  decision         ApprovalDecision @default(PENDING)
  decidedBy        String?
  decidedAt        DateTime?
  comment          String?
  createdAt        DateTime         @default(now())

  @@index([subjectType, subjectId])
  @@index([assigneeUsername, decision])
}

// ---------------------------------------------------------------- Dönem takibi

/// Dönem sonu beyanı: öğrenci ana dal GNO'sunu girer, koordinatör transkriptle doğrular.
model TermRecord {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  termId       String
  term         Term       @relation(fields: [termId], references: [id])
  mainGano     Float
  mainFrozen   Boolean    @default(false)
  declaredBy   String
  declaredAt   DateTime   @default(now())
  verifiedBy   String?
  verifiedAt   DateTime?

  @@unique([enrollmentId, termId])
}

/// Dönem izni: Erasmus/Farabi, dersin açılmaması vb. (ÇAP Yön. m.9/1-ç,d)
model TermLeave {
  id           String      @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  termId       String
  term         Term        @relation(fields: [termId], references: [id])
  reason       LeaveReason
  note         String?
  createdBy    String
  createdAt    DateTime    @default(now())

  @@unique([enrollmentId, termId])
}

model TermScan {
  id         String        @id @default(cuid())
  termId     String
  term       Term          @relation(fields: [termId], references: [id])
  startedBy  String
  status     ScanStatus    @default(QUEUED)
  error      String?
  createdAt  DateTime      @default(now())
  finishedAt DateTime?
  ruleSets   RuleSet[]
  findings   ScanFinding[]
}

model ScanFinding {
  id           String          @id @default(cuid())
  scanId       String
  scan         TermScan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id])
  ruleCode     String
  status       String
  result       Json
  decision     FindingDecision @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  reason       String?

  @@index([scanId])
}

model WithdrawalRequest {
  id                String     @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])
  reason            String
  requestedBy       String
  capToMinorOutcome Json?
  createdAt         DateTime   @default(now())
}

// ---------------------------------------------------------------- Bildirim ve denetim

model Notification {
  id        String    @id @default(cuid())
  username  String
  title     String
  body      String
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([username, readAt])
}

/// Yalnızca ekleme yapılır; UPDATE ve DELETE veritabanı tetikleyicisiyle engellenir.
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actor    String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  reason   String?
  ip       String?

  @@index([entity, entityId])
}
