// Bilgisayar Mühendisliği ÇAP / YDP takip sistemi — veri modeli (docs/KARARLAR.md K-18).
// Kayıtlar silinmez: yanlış ya da geçersiz kayıt "iptal" olarak işaretlenir; silme veritabanı
// tetikleyicisiyle engellenir. Her kayıt öğrenci numarasına bağlıdır (ileride OBİS anahtarı).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Season {
  GUZ
  BAHAR
}

enum TrackType {
  CAP
  YANDAL
}

enum UserRole {
  KOORDINATOR
  OGRENCI
  BOLUM_BASKANI
}

enum StudentStatus {
  ACTIVE
  FROZEN
  GRADUATED
  CERTIFIED
  WITHDRAWN
  REMOVED
}

/// Öğrencinin girdiği kaydın onay durumu. Onaylanan kayıt kilitlenir; reddedilen ve iptal edilen kalır.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Kaydın kaynağı. OBİS bağlantısı eklendiğinde aktarılan kayıtlar IMPORT ile yazılır.
enum RecordSource {
  STUDENT
  COORDINATOR
  BACKFILL
  IMPORT
}

enum CourseKind {
  ZORUNLU
  TEKNIK_SECMELI
  SOSYAL_SECMELI
}

enum PlanItemKind {
  COURSE
  ELECTIVE_SLOT
}

enum AttemptResult {
  TAKEN
  PASSED
  FAILED
}

enum DocumentKind {
  PROTOKOL
  DERS_KAYIT_FORMU
  MUAFIYET_FORMU
  CAP_TRANSKRIPT
  ANADAL_TRANSKRIPT
  YK_KARARI
  RESMI_YAZI
  DIGER
}

enum RequestStatus {
  OPEN
  UPLOADED
  APPROVED
  REJECTED
  CANCELLED
}

enum GanoSource {
  TRANSKRIPT
  OGRENCI_ISLERI
  OBIS
  DIGER
}

enum DecisionType {
  MEZUNIYET
  SERTIFIKA
  KAYIT_SILME
  AYRILMA
  DONDURMA
  ETKINLESTIRME
}

enum LeaveReason {
  ERASMUS
  FARABI
  DERS_ACILMADI
  DERS_CAKISMASI
  DIGER
}

enum RuleSetStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ImportKind {
  COURSES
  STUDENTS
  ATTEMPTS
}

// ---------------------------------------------------------------- Tanımlar

/// Bölümler: Bilgisayar Mühendisliği (isHome) ve öğrencilerin ana dal bölümleri.
model Program {
  id         String             @id
  name       String
  faculty    String
  codePrefix String?
  isHome     Boolean            @default(false)
  students   Student[]
  templates  ProtocolTemplate[]
}

/// Ders kataloğu (Bologna ders paketi). Pasife alınan ders yeni listelere eklenemez; geçmiş kayıtlar etkilenmez.
model Course {
  code      String          @id
  name      String
  ects      Int
  credit    Int?
  semester  Int
  kind      CourseKind
  active    Boolean         @default(true)
  updatedBy String?
  updatedAt DateTime        @updatedAt
  planItems PlanItem[]
  attempts  CourseAttempt[]
}

model Term {
  id               String            @id
  year             String
  season           Season
  startsAt         DateTime
  endsAt           DateTime
  isCurrent        Boolean           @default(false)
  admitted         Student[]
  attempts         CourseAttempt[]
  gradeSubmissions GradeSubmission[]
  ganoRecords      GanoRecord[]
  leaves           TermLeave[]
  documents        Document[]

  @@unique([year, season])
}

/// Sistem ayarları (dosya sınırları vb.). Yönerge kuralları RuleSet'tedir.
model Setting {
  key       String   @id
  value     Json
  updatedBy String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- Kullanıcılar

/// Giriş hesabı. Kimliği Keycloak doğrular; rol ve etkinlik buradadır. Hesapları koordinatör açar.
model User {
  id          String    @id @default(cuid())
  username    String    @unique
  oidcSub     String?   @unique
  displayName String
  email       String    @unique
  role        UserRole
  active      Boolean   @default(true)
  invitedAt   DateTime?
  lastLoginAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  student     Student?
  messages    Message[]
  notes       StudentNote[]
}

/// Öğrenci kartı. Öğrenci numarası benzersiz anahtardır.
model Student {
  studentNo        String               @id
  userId           String?              @unique
  user             User?                @relation(fields: [userId], references: [id])
  fullName         String
  schoolEmail      String               @unique
  phone            String?
  track            TrackType
  admissionTermId  String
  admissionTerm    Term                 @relation(fields: [admissionTermId], references: [id])
  mainProgramId    String?
  mainProgram      Program?             @relation(fields: [mainProgramId], references: [id])
  /// Ana dalda alınan, iki programda ortak sayılan derslerin AKTS toplamı (ÇAP Yön. m.7/2)
  commonEcts       Int                  @default(0)
  status           StudentStatus        @default(ACTIVE)
  source           RecordSource         @default(COORDINATOR)
  /// Dış sistemdeki karşılık (ileride OBİS)
  externalRef      String?
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  planItems        PlanItem[]
  attempts         CourseAttempt[]
  gradeSubmissions GradeSubmission[]
  documents        Document[]
  documentRequests DocumentRequest[]
  messages         Message[]
  notes            StudentNote[]
  ganoRecords      GanoRecord[]
  leaves           TermLeave[]
  courseRequests   CourseRequest[]
  ruleChecks       RuleCheck[]
  decisions        StudentDecision[]
}

// ---------------------------------------------------------------- Ders takibi

/// Öğrencinin alacağı derslerden biri (ders ya da seçmeli ders yeri). Çıkarılan ders listede "çıkarıldı" olarak kalır.
model PlanItem {
  id            String          @id @default(cuid())
  studentNo     String
  student       Student         @relation(fields: [studentNo], references: [studentNo])
  kind          PlanItemKind
  courseCode    String?
  course        Course?         @relation(fields: [courseCode], references: [code])
  /// Eklendiği andaki ders bilgisi; katalog değişse de liste değişmez
  name          String
  ects          Int
  semester      Int
  status        ReviewStatus    @default(PENDING)
  source        RecordSource
  addReason     String?
  createdBy     String
  createdAt     DateTime        @default(now())
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  removedAt     DateTime?
  removedBy     String?
  removeReason  String?
  exemptAt      DateTime?
  exemptBy      String?
  exemptReason  String?
  exemptCondNo  Int?
  attempts      CourseAttempt[]

  @@index([studentNo])
}

/// Bir dersin bir dönemdeki alınışı (deneme). Ders tekrar alınırsa yeni deneme açılır.
model CourseAttempt {
  id                String                @id @default(cuid())
  studentNo         String
  student           Student               @relation(fields: [studentNo], references: [studentNo])
  planItemId        String
  planItem          PlanItem              @relation(fields: [planItemId], references: [id])
  termId            String
  term              Term                  @relation(fields: [termId], references: [id])
  courseCode        String
  course            Course                @relation(fields: [courseCode], references: [code])
  /// Alındığı andaki ders adı ve AKTS
  courseName        String
  ects              Int
  status            ReviewStatus          @default(PENDING)
  source            RecordSource
  result            AttemptResult         @default(TAKEN)
  grade             String?
  gradedAt          DateTime?
  createdBy         String
  createdAt         DateTime              @default(now())
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?
  correctedAt       DateTime?
  correctedBy       String?
  gradeItems        GradeSubmissionItem[]

  @@index([studentNo, termId])
  @@index([planItemId])
}

/// Dönem sonu not gönderimi: öğrenci notları girer ve dönemin ÇAP / YDP not belgesini ekler.
model GradeSubmission {
  id           String                @id @default(cuid())
  studentNo    String
  student      Student               @relation(fields: [studentNo], references: [studentNo])
  termId       String
  term         Term                  @relation(fields: [termId], references: [id])
  transcriptId String
  transcript   Document              @relation(fields: [transcriptId], references: [id])
  status       ReviewStatus          @default(PENDING)
  submittedBy  String
  submittedAt  DateTime              @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  items        GradeSubmissionItem[]

  @@index([studentNo, termId])
}

model GradeSubmissionItem {
  id           String          @id @default(cuid())
  submissionId String
  submission   GradeSubmission @relation(fields: [submissionId], references: [id])
  attemptId    String
  attempt      CourseAttempt   @relation(fields: [attemptId], references: [id])
  grade        String
  /// Onayda belirlenen sonuç (DC için koordinatör işaretler)
  passed       Boolean?

  @@unique([submissionId, attemptId])
}

/// Kataloğa ders eklenmesi talebi (öğrenci serbest metinle ders giremez).
model CourseRequest {
  id          String        @id @default(cuid())
  studentNo   String
  student     Student       @relation(fields: [studentNo], references: [studentNo])
  code        String?
  name        String
  note        String
  status      ReviewStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  courseCode  String?
}

// ---------------------------------------------------------------- Belgeler ve yazışma

/// Belge arşivi. Dosya diskte; özeti ve üst verisi burada. Yeni sürüm eskisini silmez (previousId zinciri).
model Document {
  id          String            @id @default(cuid())
  studentNo   String
  student     Student           @relation(fields: [studentNo], references: [studentNo])
  kind        DocumentKind
  termId      String?
  term        Term?             @relation(fields: [termId], references: [id])
  fileName    String
  mimeType    String
  size        Int
  sha256      String
  storageKey  String            @unique
  note        String?
  status      ReviewStatus      @default(PENDING)
  uploadedBy  String
  uploadedAt  DateTime          @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  previousId  String?           @unique
  previous    Document?         @relation("Versions", fields: [previousId], references: [id])
  next        Document?         @relation("Versions")
  requestId   String?
  request     DocumentRequest?  @relation(fields: [requestId], references: [id])
  messageId   String?
  message     Message?          @relation(fields: [messageId], references: [id])
  submissions GradeSubmission[]

  @@index([studentNo, kind])
}

/// Koordinatörün öğrenciden belge ya da bilgi istemesi; yanıtı izlenir.
model DocumentRequest {
  id         String        @id @default(cuid())
  studentNo  String
  student    Student       @relation(fields: [studentNo], references: [studentNo])
  kind       DocumentKind
  termId     String?
  message    String
  dueDate    DateTime?
  status     RequestStatus @default(OPEN)
  createdBy  String
  createdAt  DateTime      @default(now())
  closedAt   DateTime?
  documents  Document[]
}

/// Koordinatör ile öğrenci arasındaki yazışma. Kalıcıdır, silinemez.
model Message {
  id          String     @id @default(cuid())
  studentNo   String
  student     Student    @relation(fields: [studentNo], references: [studentNo])
  senderId    String
  sender      User       @relation(fields: [senderId], references: [id])
  body        String
  createdAt   DateTime   @default(now())
  /// Karşı tarafın okuduğu an
  readAt      DateTime?
  attachments Document[]

  @@index([studentNo, createdAt])
}

/// Koordinatörün öğrenci kartına eklediği not; öğrenci görmez.
model StudentNote {
  id           String    @id @default(cuid())
  studentNo    String
  student      Student   @relation(fields: [studentNo], references: [studentNo])
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  body         String
  createdAt    DateTime  @default(now())
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
}

// ---------------------------------------------------------------- Kurallar ve kararlar

/// Ana dal genel not ortalaması (GANO). Yalnızca koordinatör girer; kaynağı yazılır.
model GanoRecord {
  id            String     @id @default(cuid())
  studentNo     String
  student       Student    @relation(fields: [studentNo], references: [studentNo])
  termId        String
  term          Term       @relation(fields: [termId], references: [id])
  gano          Float
  source        GanoSource
  sourceNote    String?
  mainFrozen    Boolean    @default(false)
  mainGraduated Boolean    @default(false)
  enteredBy     String
  createdAt     DateTime   @default(now())
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?
}

/// Haklı ve geçerli mazeretle dönem izni (ders almama sayılmaz).
model TermLeave {
  id           String      @id @default(cuid())
  studentNo    String
  student      Student     @relation(fields: [studentNo], references: [studentNo])
  termId       String
  term         Term        @relation(fields: [termId], references: [id])
  reason       LeaveReason
  note         String?
  createdBy    String
  createdAt    DateTime    @default(now())
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
}

/// Sürümlü kural seti. Yeni değer yeni sürümle girilir; eski sürüm ve onunla yapılmış kontroller kalır.
model RuleSet {
  id            String           @id @default(cuid())
  version       String           @unique
  type          TrackType
  effectiveFrom DateTime
  status        RuleSetStatus    @default(DRAFT)
  note          String?
  createdBy     String?
  createdAt     DateTime         @default(now())
  rules         RuleDefinition[]
  checks        RuleCheck[]
}

model RuleDefinition {
  id        String  @id @default(cuid())
  ruleSetId String
  ruleSet   RuleSet @relation(fields: [ruleSetId], references: [id])
  code      String
  kind      String
  article   String
  title     String
  phase     String
  params    Json
  position  Int

  @@unique([ruleSetId, code])
}

/// Bir kural kontrolünün değiştirilemez sonucu: kullanılan sürüm, girdiler ve sonuçlar.
model RuleCheck {
  id        String            @id @default(cuid())
  studentNo String
  student   Student           @relation(fields: [studentNo], references: [studentNo])
  ruleSetId String
  ruleSet   RuleSet           @relation(fields: [ruleSetId], references: [id])
  trigger   String
  inputs    Json
  results   Json
  worst     String
  createdBy String
  createdAt DateTime          @default(now())
  decisions StudentDecision[]

  @@index([studentNo, createdAt])
}

/// Mezuniyet, sertifika, kayıt silme gibi kararlar. Sistem uyarır, kararı koordinatör verir.
model StudentDecision {
  id             String        @id @default(cuid())
  studentNo      String
  student        Student       @relation(fields: [studentNo], references: [studentNo])
  type           DecisionType
  reason         String
  reference      String?
  ruleCheckId    String?
  ruleCheck      RuleCheck?    @relation(fields: [ruleCheckId], references: [id])
  previousStatus StudentStatus
  newStatus      StudentStatus
  decidedBy      String
  decidedAt      DateTime      @default(now())
  cancelledAt    DateTime?
  cancelledBy    String?
  cancelReason   String?
}

/// Ders listesi şablonu (bölüm sitesindeki Kabul ve Ders Protokolleri).
model ProtocolTemplate {
  id              String                 @id @default(cuid())
  type            TrackType
  sourceProgramId String?
  sourceProgram   Program?               @relation(fields: [sourceProgramId], references: [id])
  title           String
  commonEcts      Int                    @default(0)
  source          String?
  updatedBy       String?
  updatedAt       DateTime               @updatedAt
  items           ProtocolTemplateItem[]
  conditions      ProtocolCondition[]

  @@unique([type, sourceProgramId])
}

model ProtocolTemplateItem {
  id         String           @id @default(cuid())
  templateId String
  template   ProtocolTemplate @relation(fields: [templateId], references: [id])
  position   Int
  kind       PlanItemKind
  code       String?
  name       String
  ects       Int
  semester   Int
  /// Şablon güncellenince eski satır pasife alınır (silinmez)
  active     Boolean          @default(true)

  @@index([templateId, position])
}

/// Protokolün altındaki numaralı özel şart: ana dalda alınan ders, listedeki dersten muaf sayar.
model ProtocolCondition {
  id               String           @id @default(cuid())
  templateId       String
  template         ProtocolTemplate @relation(fields: [templateId], references: [id])
  no               Int
  sourceCourseCode String
  sourceCourseName String
  targetCourseCode String
  note             String?

  @@unique([templateId, no])
}

// ---------------------------------------------------------------- Aktarım, bildirim, denetim

/// Dışarıdan veri aktarımı (CSV; ileride OBİS). Satırlar elle girişle aynı servislerden geçer.
model ImportBatch {
  id        String     @id @default(cuid())
  kind      ImportKind
  rowCount  Int
  okCount   Int
  summary   Json
  createdBy String
  createdAt DateTime   @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  username  String
  title     String
  body      String
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([username, readAt])
}

/// Yalnızca ekleme yapılır; UPDATE ve DELETE veritabanı tetikleyicisiyle engellenir.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  actor     String
  actorRole String?
  action    String
  entity    String
  entityId  String
  studentNo String?
  before    Json?
  after     Json?
  reason    String?
  ip        String?

  @@index([entity, entityId])
  @@index([studentNo, at])
}
